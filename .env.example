GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
GEMINI_API_KEY_FALLBACK_2=
# Optional override. Leave unset to use the built-in best→worst Flash chain (no Pro models).
# GEMINI_MODEL_CHAIN=gemini-3.5-flash,gemini-flash-latest,gemini-3-flash-preview,gemini-2.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash,gemini-1.5-flash-8b
# How many full generation passes when a draft is too thin (each pass walks models × keys). Default ~5–7, max 12.
# GEMINI_SUBSTANTIVE_ATTEMPTS=6
# Deep single-topic web research when a lead is thin (uses Gemini Google Search grounding). Set false to disable.
# DEEP_RESEARCH_ENABLED=true
# Manual Blogger paste packages (default posts/, start at No.01)
# POSTS_DIR=
# POSTS_START_NUMBER=1
# Private Reddit custom/multireddit RSS URL (Fallout subs only). When set, individual subreddit fetches are skipped.
REDDIT_CUSTOM_FEED_URL=
# How many Reddit posts to keep from the custom feed after quality filters (default 25; typical RSS feeds have ~25).
# REDDIT_CUSTOM_FEED_ITEM_LIMIT=25
# REDDIT_CUSTOM_FEED_MAX_RANK=30
# COLLECTED_ITEM_POOL_LIMIT=45
# Discord webhook for announcing newly published Blogger posts (GitHub secret: DISCORD_WEBHOOK_URL)
DISCORD_WEBHOOK_URL=
# BLOG_FEED_URL=https://www.fallouthub.blog/feeds/posts/default?alt=rss
# Optional: seed an official studio post via data/manual-seeds.json (title, link, description, tier: "official")